# ============================================
# GemVerify — Environment Configuration
# Copy to .env in each service directory
# ============================================

# PostgreSQL
DATABASE_URL=postgres://gemuser:gempass123@localhost:5432/gemverify?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gemverify
MINIO_USE_SSL=false

# JWT Authentication
JWT_SECRET=gemverify-local-dev-secret-key-2024
JWT_EXPIRY_MINUTES=1440

# Go Gateway
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# AI Service (gRPC)
AI_SERVICE_ADDR=localhost:50051
GRPC_PORT=50051

# Mock Government API
MOCK_GOV_API_URL=http://localhost:8001

# Groq API (for AI recommendations)
GROQ_API_KEY=your-groq-api-key-here

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
